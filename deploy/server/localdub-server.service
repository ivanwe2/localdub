# systemd unit for the localdub web app (installed by install.sh). It runs the engine as root, like
# the CLI on the reference box, and listens on this machine only: reach it through an SSH tunnel
# (ssh -N -L 8080:127.0.0.1:8080 root@<box>) until the server has a login.
[Unit]
Description=localdub web app (server and page)
After=network-online.target llama-swap.service
Wants=network-online.target

[Service]
Environment=LOCALDUB_HOME=/root/dub
Environment=LOCALDUB_ENGINE=/usr/local/bin/localdub
Environment=LOCALDUB_WEB=/opt/localdub/web
Environment=LOCALDUB_LISTEN=127.0.0.1:8080
Environment=LOCALDUB_MODELS_URL=http://127.0.0.1:9876
# LLAMA_API_KEY, for the models' status (the engine also reads this file itself)
EnvironmentFile=-/etc/llama.env
Environment=HOME=/root
Environment=LANG=C.UTF-8
ExecStart=/opt/localdub/localdub-server
Restart=on-failure
RestartSec=5
# a run still going when the service stops is stopped with it; `localdub run <name>` continues it
KillMode=control-group
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
