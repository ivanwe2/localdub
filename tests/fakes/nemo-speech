#!/usr/bin/env python3
"""Fake nemo-speech (the local backend): `transcribe <folder>` writes <stem>.json for each WAV.
What it hears is in fake_asr.py."""
import hashlib
import json
import os
import sys
from pathlib import Path

from fake_asr import part, take, wav_seconds

a = sys.argv[1:]
assert a[0] == "transcribe" and "--model" in a and "--config" in a and a[a.index("--format") + 1] == "json"
src, out = Path(a[1]), Path(a[a.index("--output-dir") + 1])
out.mkdir(parents=True, exist_ok=True)
state = Path(os.environ["LOCALDUB_FAKE_STATE"])
with open(state / "asr-local.log", "a", encoding="utf-8") as f:
    f.write(f"{src}\n")

files = sorted(src.glob("*.wav"))
if files and files[0].stem.startswith("part"):
    words = json.loads(Path(os.environ["LOCALDUB_FAKE_WORDS"]).read_text(encoding="utf-8"))
    offset = 0.0
    for f in files:
        d = wav_seconds(str(f))
        (out / f"{f.stem}.json").write_text(json.dumps(part(words, offset, d), ensure_ascii=False), encoding="utf-8")
        offset += d
else:
    run = src.parent.parent
    channel = json.loads((run / "state.json").read_text())["channel"]
    voice = Path(os.environ["LOCALDUB_HOME"]) / "channels" / channel / "voice.wav"
    ref = hashlib.md5(voice.read_bytes()).hexdigest()
    texts = [json.loads(line) for line in open(state / "tts.log", encoding="utf-8")]
    by_hash = {hashlib.md5((ref + t).encode()).hexdigest()[:8]: t for t in texts}
    for f in files:
        voiced = by_hash[f.stem.split("-")[1]]
        (out / f"{f.stem}.json").write_text(json.dumps(take(f.stem, voiced, wav_seconds(str(f)))), encoding="utf-8")
